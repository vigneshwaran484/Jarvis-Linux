# Paths
SCREENSHOT_DIR=~/Pictures/jarvis
VIDEO_DIR=~/Videos/jarvis

# LLM Configuration
LLM_MODEL=qwen3:4b-instruct
LLM_ENDPOINT=http://localhost:11434/api/chat
LLM_MAX_STEPS=6
LLM_THINK=false                   # reasoning models (qwen3...) skip "thinking"; true | false | auto
# JARVIS_PERSONA=                 # personality line for the system prompt; set empty to disable
HOME_CITY=                        # weather city when none is spoken (empty = guess from IP)

# Voice Configuration
STT_ENGINE=whisper                # whisper (on-device) | google (online)
TTS_ENGINE=kokoro                 # kokoro | piper (both on-device) | edge (online)
KOKORO_VOICE=bm_george            # hear the options with: python voice_demo.py
KOKORO_SPEED=1.0
WHISPER_MODEL=base.en             # tiny.en | base.en | small.en | small (multilingual)
WHISPER_MIN_CONFIDENCE=0.35       # reject Whisper transcripts below this confidence
PIPER_VOICE=en_GB-alan-medium     # fetch with: python -m piper.download_voices <name> --data-dir voices
TTS_VOICE=en-AU-WilliamNeural     # edge-tts voice, used when TTS_ENGINE=edge or as the fallback
STT_LANGUAGE=en-IN                # Google STT language, used when STT_ENGINE=google or as the fallback
PHRASE_TIME_LIMIT=10

# Wake Word Detection (openWakeWord — CPU-only, offline)
WAKEWORD_ENABLED=true
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5
WAKEWORD_CONFIRM_THRESHOLD=0.15   # borderline scores above this are checked by Whisper for "Jarvis"

# Reliability
LLM_TIMEOUT=30
LLM_CIRCUIT_FAILURE_THRESHOLD=2   # consecutive Ollama failures before failing fast
LLM_CIRCUIT_RECOVERY_SECONDS=30   # how long to fail fast before re-trying Ollama
STT_MIN_CONFIDENCE=0.5
LOG_FILE=jarvis.log

# Email (optional, read-only). Gmail: use an app password, not the account password.
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
MAIL_IMAP_HOST=imap.gmail.com

# Memory
MEMORY_DIR=memory_data
SHORT_TERM_WINDOW=10
SHORT_TERM_PERSIST=true
LONG_TERM_TOP_K=3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Web search (optional). Without a key, search_web uses DuckDuckGo Instant Answers + Wikipedia.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=8
